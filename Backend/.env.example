DATABASE_URL=<username>:<password>@tcp(localhost:3306)/integrityguard?parseTime=true
HTTP_ADDR=:8080
TCP_ADDR=:9000
TLS_CA=./certs/ca.crt
TLS_CERT=./certs/server.crt
TLS_KEY=./certs/server.key
# LLM 리포트 서버 (POST /api/reports/summary 프록시 대상). 미설정 시 기본값 사용.
LLM_SERVER_URL=http://127.0.0.1:8088
ENROLL_ADDR=:9443
AGENT_CA_CERT=./certs/ca.crt
AGENT_CA_KEY=./certs/ca.key
AGENT_CERT_TTL_HOURS=8760
# Generate both values before use:
#   openssl rand -base64 32
ENROLL_SECRET_PEPPER=
ENROLL_KEY_KEK=
