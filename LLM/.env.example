# KN-IG LLM Server configuration.
# Copy to .env and fill in keys. Keys live ONLY here — never in the backend or browser.

# Provider order, comma-separated. First with a valid key wins; others are fallback.
# Structured report JSON stability is usually best with OpenAI first:
# PROVIDER_ORDER=openai,gemini
PROVIDER_ORDER=gemini,openai

# Google Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI GPT (fallback, or primary if PROVIDER_ORDER=openai,gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# uvicorn port (informational; pass --port to uvicorn to override)
LLM_PORT=8088
